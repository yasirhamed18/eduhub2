# EduHub Backend Environment Configuration
# Copy this file to .env and adjust values for your machine.

# Server
PORT=4000
NODE_ENV=development

# CORS - the frontend origin(s) allowed to talk to this API
CLIENT_ORIGIN=http://localhost:3000

# MySQL connection (XAMPP defaults: root with no password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eduhub

# JSON Web Token secret - CHANGE THIS to a long random string in production
JWT_SECRET=change-this-secret

# Admin account created by `npm run db:setup`
# CHANGE THE PASSWORD - it is used to generate the bcrypt hash at setup time
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eduhub.local
ADMIN_PASSWORD=change-this-admin-password

# Session expiry
JWT_EXPIRES_IN=7d

# Where uploaded files are stored on disk (relative to backend/)
UPLOAD_DIR=uploads

# Public URL prefix used to serve uploaded files
UPLOAD_BASE_URL=http://localhost:4000/uploads

# Multer file size limit in bytes (default 50MB)
MAX_FILE_BYTES=52428800
