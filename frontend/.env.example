# EduHub Frontend Environment Configuration
# Copy this file to .env.local and adjust values for your machine.
# NEXT_PUBLIC_* variables are inlined at build time; none of them are secrets.

# Backend origin used by the Next.js server-side rewrite (/api/backend/*)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Client-side API base path used by src/lib/api.ts (relative to the frontend)
NEXT_PUBLIC_API_BASE=/api/backend